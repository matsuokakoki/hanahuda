FROM node:22.22.0-bookworm-slim AS node-runtime
FROM eclipse-temurin:21-jre-jammy
COPY --from=node-runtime /usr/local/ /usr/local/
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY functions/package.json functions/package.json
COPY packages/game-core/package.json packages/game-core/package.json
RUN npm install --no-audit --no-fund && npx playwright install --with-deps chromium
COPY . .
RUN npm run build
EXPOSE 4000 5000 5001 8080 9099
